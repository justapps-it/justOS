# virtio GPU: the paravirtual display of QEMU/KVM (-vga virtio) and other
# hypervisors. 2D only: justOS draws everything itself. Several outputs
# (max_outputs) are several monitors, side by side or mirrored.
name        = virtiogpu
version     = 1.2.0
class       = display
description = virtio GPU display
author      = justOS
match       = pci 1af4:1050
